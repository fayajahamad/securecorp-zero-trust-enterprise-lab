
loki.source.file "securecorp" {
  targets = [
    {
      __path__ = "/var/log/securecorp/*.log",
      job      = "securecorp-lab",
    },
  ]

  forward_to = [loki.write.local.receiver]

  file_match {
    enabled = true
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
